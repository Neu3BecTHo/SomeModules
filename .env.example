# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=belonogova
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8

# Cookie Validation Key - Generate a random 32+ character string
# Usage: openssl rand -base64 32
COOKIE_VALIDATION_KEY=

# Mailer Configuration
MAILER_TRANSPORT_SCHEME=smtps
MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_USERNAME=your_email@gmail.com
MAILER_PASSWORD=your_app_password
MAILER_USE_FILE_TRANSPORT=false

# SSL Configuration for Mailer
MAILER_SSL_ALLOW_SELF_SIGNED=false
MAILER_SSL_VERIFY_PEER=true
MAILER_SSL_VERIFY_PEER_NAME=true

# Application Environment
YII_ENV=prod
YII_DEBUG=false

# Admin Email
ADMIN_EMAIL=admin@example.com
SENDER_EMAIL=noreply@example.com
SENDER_NAME="Belonogova App"
